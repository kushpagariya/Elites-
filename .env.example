# Backend environment (set explicitly; uvicorn does not load this file automatically).
FRONTEND_ORIGIN=http://localhost:3000
# Persistent directory must survive deployments. Accounts are stored alongside this file.
# Default: repository .runtime/storescout-bengaluru.sqlite3, with one workspace file per account.
# STORESCOUT_DB_PATH=/absolute/persistent/path/storescout-bengaluru.sqlite3
# Set to 1 behind HTTPS in production; localhost uses 0.
# STORESCOUT_SECURE_COOKIES=1
# Max two calculation workers. Timeout must be >0 and <=120 seconds.
# STORESCOUT_COMPUTE_TIMEOUT_SECONDS=15
