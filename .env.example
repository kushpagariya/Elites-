# Copy frontend/.env.example to frontend/.env.local for the browser API URL.
FRONTEND_ORIGIN=http://localhost:3000
# Optional absolute local SQLite path. Default is repository .runtime/storescout.sqlite3.
# STORESCOUT_DB_PATH=
# Model bundle directory containing model_card.json and its fitted artifact.
# STORESCOUT_MODEL_DIR=
# Worker timeout in seconds (0 < value <= 120); default 15. Max two workers.
# STORESCOUT_COMPUTE_TIMEOUT_SECONDS=15
